ifndef BIOS
$(error NeoGeo BIOS not specified: use make mvs64 BIOS=<bios.bin>)
endif
ifndef ROM
$(error NeoGeo game ROM not specified: use make mvs64 ROM=<rom.zip>)
endif

BUILD_DIR = build/mvs64

include $(N64_INST)/include/n64.mk

core_src = emu.c emu_diag.c roms.c hw.c video.c platform_n64.c sprite_cache.c sound_neogeo.c z80_anchor.c z80.c ym2610/ym2610.c lib/rdl.c $(wildcard hle_*.c)
rsp = rsp_video.S rsp_audio.S rsp_fm.S
ifdef MUSASHI
# Fallback 68k core: portable Musashi (the PC build's core). Much slower than
# m64k, but useful to isolate m64k bugs on a new game. No m64k TLB asm;
# memory goes through the banks[] callbacks in hw.c.
src = $(core_src) m68kcpu.c m68kops.c m68kdasm.c
asm =
else
# Default: fast m64k MIPS-asm 68k interpreter (0xFF000000 TLB window + hw_n64.S).
src = $(core_src) m64k/m64k.c m64k/tlb.c
asm = hw_n64.S m64k/m64k_asm.S
CFLAGS += -DUSE_M64K
# DBF block-op fast path: fused copy/fill loops. The VRAM-port helper lives
# in hw_n64.S, so only game builds enable it (the standalone testsuite has no
# hw_n64.S). The fused path must be bit- and cycle-exact against the
# interpreter; make ... BLOCKOPS_OFF=1 builds it out for A/B gating.
ifndef BLOCKOPS_OFF
CFLAGS += -DM64K_BLOCKOPS
ASFLAGS += -DM64K_BLOCKOPS
N64_ASFLAGS += -DM64K_BLOCKOPS
endif
# Inline stores to the LSPC VRAM ports (0x3C0000/2/4) in the hot MOVE.w and
# MOVE.l fast paths, so those writes skip the TLB trap. Game builds only
# (references lspc.c's registers and VIDEO_RAM). make ... PORTSTORE_OFF=1
# builds it out.
ifndef PORTSTORE_OFF
ASFLAGS += -DM64K_PORTSTORE
N64_ASFLAGS += -DM64K_PORTSTORE
endif
# Inline fast paths for the most frequent opcode forms (Bcc/DBcc, RTS,
# common MOVE.b/.w/.l forms, ADDQ/SUBQ/CMPI/ADD/TST on simple operands).
# Covered by the m64k testsuite, which builds with the same define.
# make ... FP_OFF=1 builds without them, for A/B comparisons.
ifndef FP_OFF
CFLAGS += -DM64K_FASTPATHS
ASFLAGS += -DM64K_FASTPATHS
N64_ASFLAGS += -DM64K_FASTPATHS
endif
endif
obj = $(src:%.c=$(BUILD_DIR)/%.o) $(asm:%.S=$(BUILD_DIR)/%.o) $(rsp:%.S=$(BUILD_DIR)/%.o)

src_makerom = mvsmakerom.c miniz.c
obj_makerom = $(src_makerom:%.c=$(BUILD_DIR)/%.o)

CFLAGS += -Wno-unused-function
CFLAGS += $(EXTRA_DEFINES)
# Propagate EXTRA_DEFINES to the assembler too, so .S-file feature gates
# take effect like C ones.
ASFLAGS += $(EXTRA_DEFINES)
# ...and to the RSP assembler (rsp_*.S build with RSPASFLAGS), so ucode-side
# twin knobs (e.g. -DMVS64_ROTA_OFF in rsp_video.S) can be driven the same way.
RSPASFLAGS += $(EXTRA_DEFINES)
N64_ASFLAGS += $(EXTRA_DEFINES)

# RSP audio offload, default ON. The YM2610 FM and ADPCM-A/B synthesis runs
# on the RSP (rsp_fm.S, rsp_audio.S) as a "whole pump": per-chunk commands
# with the synthesis state resident on the RSP, and the output collected one
# pump later, so the CPU never waits per chunk. Bit-exact against the C core
# (dual-compute gate: EXTRA_DEFINES=-DMVS64_RSPWP_VERIFY, [RSPWP] counters).
# Measured in ares on samsho2: in-game fps roughly doubled versus the CPU
# path. Needs the rspq patches in patches/ (see README.md).
# make ... ADPCM_CPU=1 WP_OFF=1 forces the C synthesis path (debug/fallback).
ifndef ADPCM_CPU
CFLAGS += -DMVS64_RSPADPCM
else ifndef WP_OFF
$(error ADPCM_CPU=1 needs WP_OFF=1: the whole-pump offload keeps the ADPCM state on the RSP)
endif
ifndef WP_OFF
CFLAGS += -DMVS64_RSPFM -DMVS64_RSPWP
endif

ifdef FRAMESKIP
# Auto frameskip: skip drawing up to $(FRAMESKIP) frames in a row when the
# emulation is behind the VI clock, so game speed holds (emu_render, emu.c).
# Default off (0): the game slows down instead.
CFLAGS += -DMVS64_FRAMESKIP=$(FRAMESKIP)
endif

# NOTE: the audio TUs (ym2610.c/z80.c/sound_neogeo.c) stay at -O2, measured
# both ways on N64: -O3 made in-game sound time ~40% worse (the inline/unroll
# bloat thrashes the VR4300 16KB icache in the synthesis loop), and -Os was
# also slower (shorter but branchier code loses more in the synthesis inner
# loops than the icache saves).

ROMNAME=$(notdir $(basename $(ROM)))
ROMDIR=$(ROM:%.zip=%.n64)

all: mvsmakerom mvs64-${ROMNAME}.z64

test:
	make -f Makefile.tests all

$(BUILD_DIR)/mvs64-${ROMNAME}.dfs: $(ROM) mvsmakerom
	@echo "    [MVS] ${ROMDIR}"
	./mvsmakerom $(BIOS) $(ROM)
	@echo "    [DFS] $@"
	$(N64_MKDFS) $@ $(ROMDIR) >/dev/null

mvs64-${ROMNAME}.z64: $(BUILD_DIR)/mvs64-${ROMNAME}.dfs
mvs64-${ROMNAME}.z64: N64_ROM_TITLE="MVS64: ${ROMNAME}"
$(BUILD_DIR)/mvs64-${ROMNAME}.elf: $(obj)

mvsmakerom: $(obj_makerom)
	@echo "    [LD] $@"
	$(CC) $(LDFLAGS) -o $@ $^

clean:
	rm -f $(obj)
	rm -f $(obj_makerom)
	rm -f $(asm:%.S=$(BUILD_DIR)/%.o)
	rm -f $(rsp:%.S=$(BUILD_DIR)/%.rsp)
	rm -f $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d)
	rm -f mvs64-*.elf
	rm -f mvs64-*.dfs
	rm -f mvs64-*.z64

-include $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d) $(src_makerom:%.c=$(BUILD_DIR)/%.d)

.PHONY: clean test
